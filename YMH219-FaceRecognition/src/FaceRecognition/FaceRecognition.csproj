<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FaceRecognition.Core\FaceRecognition.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yüz algılama modeli çıktı klasörüne kopyalanır -->
    <None Update="Models\haarcascade_frontalface_default.xml" CopyToOutputDirectory="PreserveNewest" />
